# SPARQL Endpoint Configuration
# Works with any SPARQL 1.1 compliant endpoint (Apache Jena, GraphDB, Virtuoso, etc.)
ONTOLOGY_SPARQL_ENDPOINT=

# Optional: Authentication credentials (if your endpoint requires them)
SPARQL_USERNAME=
SPARQL_PASSWORD=

# Graph Configuration (choose one approach):
# Option 1: Specify named graph URIs (comma-separated)
NAMED_GRAPHS=

# Option 2: Use the default graph (set to true if NAMED_GRAPHS is empty)
USE_DEFAULT_GRAPH=true
